# ⚙️ Configuración del Grabador invitamx
# Copiar este archivo a .env y ajustar los valores

# Playwright - Configuración de grabación
PLAYWRIGHT_DEBUG=false
CHROMIUM_PATH=

# Resolución del video (vertical)
RECORDING_WIDTH=1080
RECORDING_HEIGHT=1920
RECORDING_FPS=30
RECORDING_CODEC=vp9
RECORDING_QUALITY=high

# URLs
APP_URL=https://invitamx.vercel.app

# Datos de demostración
DEMO_NAME=Hannia
DEMO_DATE=15062024
DEMO_LOCATION=Puebla, Mexico
DEMO_THEME=Dorado Clásico

# Logging
LOG_LEVEL=info
LOG_FILE=logs/invitamx-grabador.log

# Velocidades de tipeo (delay en ms)
KEYBOARD_DELAY=60
KEYBOARD_SLOW_DELAY=100

# Timeouts
NAVIGATION_TIMEOUT=30000
WAIT_FOR_ELEMENT_TIMEOUT=5000

# Carpeta de salida
OUTPUT_DIR=videos
OUTPUT_FORMAT=webm
